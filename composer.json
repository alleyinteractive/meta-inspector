{
  "name": "alleyinteractive/meta-inspector",
  "description": "View various types of meta data about WordPress objects to assist debugging.",
  "license": "GPL-2.0-or-later",
  "type": "wordpress-plugin",
  "keywords": [
    "wordpress",
    "wordpress-plugin",
    "developer"
  ],
  "homepage": "https://github.com/alleyinteractive/meta-inspector/",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "alleyinteractive/alley-coding-standards": "^2.6",
    "gin0115/buddypress-stubs": "^14.4",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "phpcbf": "phpcbf .",
    "phpcs": "phpcs .",
    "phpstan": "phpstan --memory-limit=1G",
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "lint:fix": [
      "@phpcbf"
    ],
    "release": "npx @alleyinteractive/create-release@latest",
    "test": [
      "@lint"
    ]
  }
}
